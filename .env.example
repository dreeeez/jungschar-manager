# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_CHAT_ID=-1001234567890

# Supabase (nur server-seitig — der Browser bekommt keinen Schlüssel mehr,
# alle Anfragen der Mini-App laufen über /api/db)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key

# Vercel Cron
CRON_SECRET=your_random_secret_string

# Test-Chat für Reminder-Tests (?test=1|2|3 routet hierher)
TELEGRAM_TEST_CHAT_ID=-100xxxxxxxxx

# Optional: Secret für den Telegram-Webhook. Wenn gesetzt, akzeptiert
# /api/telegram nur noch Updates mit passendem Header. Beim Setzen muss
# der Webhook neu registriert werden:
#   https://api.telegram.org/bot<TOKEN>/setWebhook?url=<url>/api/telegram&secret_token=<wert>
TELEGRAM_WEBHOOK_SECRET=

# Nur lokale Entwicklung: außerhalb von Telegram gibt es kein initData.
# Mit einer hier eingetragenen — in `helpers` registrierten — Telegram-ID
# lässt sich die Mini-App lokal öffnen. In Production wirkungslos.
DEV_TELEGRAM_USER_ID=
